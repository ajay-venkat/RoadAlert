# MongoDB connection URI (local or Atlas)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=roadwatch

# Path to fine-tuned YOLO weights (relative to backend/)
MODEL_PATH=models/weights/best.pt
# Fallback if fine-tuned model not found
FALLBACK_MODEL=yolov8s.pt

# Detection thresholds
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Severity thresholds (box area as fraction of frame area)
SEVERITY_MINOR_MAX=0.02
SEVERITY_MODERATE_MAX=0.05

# Upload directory for saved detection images
UPLOAD_DIR=static/detections

# Server config
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
